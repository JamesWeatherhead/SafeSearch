# SafeSearch Environment Configuration Example
# Copy this file to .env and update with your actual values

# Core Application Settings
SECRET_KEY=your-secret-key-here
DEBUG=true
ENVIRONMENT=dev
SERVER_HOST=http://localhost:8000

# Database Configuration
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Email Configuration
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
DEFAULT_FROM_NAME=SafeSearch
EMAILS_ENABLED=false

# First Superuser
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123

# Sentry (Optional - for production error tracking)
# SENTRY_DSN=https://your-sentry-dsn-here


# PAGINATION_PER_PAGE=<REPLACE-ME>
# AUTH_TOKEN_LIFETIME_SECONDS=<REPLACE-ME>

# SafeSearch Configuration
# Azure OpenAI Settings
SAFESEARCH_AZURE_OPENAI_API_KEY=your-azure-openai-api-key
SAFESEARCH_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
SAFESEARCH_AZURE_OPENAI_API_VERSION=2023-12-01-preview
SAFESEARCH_AZURE_OPENAI_GPT4_DEPLOYMENT=gpt-4o
SAFESEARCH_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
SAFESEARCH_AZURE_OPENAI_EMBEDDING_DIMENSIONS=3068

# Perplexity API Settings
SAFESEARCH_PERPLEXITY_API_KEY=your-perplexity-api-key
SAFESEARCH_PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions

# SafeSearch Database Settings (should match docker-compose.yml)
SAFESEARCH_DB_HOST=localhost
SAFESEARCH_DB_PORT=5433
SAFESEARCH_DB_NAME=postgres
SAFESEARCH_DB_USER=postgres
SAFESEARCH_DB_PASSWORD=postgres
SAFESEARCH_DB_SCHEMA=safesearch

# SafeSearch Processing Settings
SAFESEARCH_VECTOR_SEARCH_TOP_K=10
SAFESEARCH_RERANK_TOP_K=5
SAFESEARCH_MAX_CONCURRENT_EMBEDDINGS=10
SAFESEARCH_EMBEDDING_BATCH_SIZE=100
SAFESEARCH_QUERY_TIMEOUT_SECONDS=300

# SafeSearch PHI Detection
SAFESEARCH_PHI_CHECK_ENABLED=true
SAFESEARCH_PHI_SIMILARITY_THRESHOLD=0.8

# SafeSearch Caching
SAFESEARCH_CACHE_EMBEDDINGS=true
SAFESEARCH_CACHE_TTL_SECONDS=3600 
